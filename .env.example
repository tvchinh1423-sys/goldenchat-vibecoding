# SUPABASE CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# BOTCAKE & WEBHOOK CONFIGURATION
BOTCAKE_VERIFY_TOKEN=omnichat_kstudy_vibecoding_2026

# TELEGRAM BOT ALERT (TÙY CHỌN)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI CONFIGURATION (Gemini / 9Router)
GEMINI_API_KEY=
NINE_ROUTER_API_KEY=

# Leave AI_PROVIDER empty to auto-select a configured key. With no keys, Inbox uses a labeled FAQ demo.
AI_PROVIDER=
GEMINI_MODEL=gemini-3.1-flash-lite
# 9Router OpenAI-compatible base URL including /v1 (server-side only)
NINE_ROUTER_BASE_URL=http://localhost:20128/v1
# Use an exact model ID available in your 9Router dashboard
NINE_ROUTER_MODEL=

# CRM: demo persists in this browser; supabase enables shared CRM behind login.
CRM_MODE=demo
# Server-only; required with CRM_MODE=supabase. Never use NEXT_PUBLIC_ for these.
SUPABASE_SERVICE_ROLE_KEY=
CRM_ACCESS_PASSWORD=
